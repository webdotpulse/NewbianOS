#!/bin/sh
# ==============================================================================
# Chroot Hook: Configure Snapper Btrfs Subvolume Snapshots & Rollback Automation
# ==============================================================================

set -e

echo "⚡ [NewbianOS Hook] Configuring Snapper, GRUB-Btrfs rollback menu, and systemd-sysext..."

# 1. Ensure snapper config directory exists
mkdir -p /etc/snapper/configs

cat << 'EOF' > /etc/snapper/configs/root
# Subvolume snapshot config for NewbianOS root
SUBVOLUME="/"
FSTYPE="btrfs"
QGROUP=""
SPACE_LIMIT="0.5"
FREE_LIMIT="0.2"
ALLOW_USERS="root"
ALLOW_GROUPS="sudo"
SYNC_ACL="yes"
BACKGROUND_COMPARISON="yes"
NUMBER_CLEANUP="yes"
NUMBER_MIN_AGE="1800"
NUMBER_LIMIT="50"
NUMBER_LIMIT_IMPORTANT="10"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="1800"
TIMELINE_LIMIT_HOURLY="10"
TIMELINE_LIMIT_DAILY="7"
TIMELINE_LIMIT_WEEKLY="4"
TIMELINE_LIMIT_MONTHLY="12"
TIMELINE_LIMIT_YEARLY="0"
EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="1800"
EOF

# 2. Add root to /etc/default/snapper
mkdir -p /etc/default
cat << 'EOF' > /etc/default/snapper
SNAPPER_CONFIGS="root"
EOF

# 3. Setup systemd-sysext extension directory
mkdir -p /var/lib/extensions
mkdir -p /var/lib/confexts

# 4. Enable snapper timeline and cleanup timers
systemctl enable snapper-timeline.timer 2>/dev/null || true
systemctl enable snapper-cleanup.timer 2>/dev/null || true
systemctl enable grub-btrfsd.service 2>/dev/null || true

echo "✓ Btrfs Snapper rollback automation configured."
