#!/bin/sh
# ==============================================================================
# Chroot Hook: Setup Modern Developer Shell & Starship Prompt
# ==============================================================================

set -e

echo "⚡ [NewbianOS Hook] Setting up Starship prompt and Zsh defaults..."

# Install Starship if not already packaged
if ! command -v starship >/dev/null 2>&1; then
    mkdir -p /usr/local/bin
    curl -sS https://starship.rs/install.sh | sh -s -- -y >/dev/null 2>&1 || true
fi

# Set default user shell to zsh in /etc/default/useradd
sed -i 's|SHELL=/bin/sh|SHELL=/bin/zsh|g' /etc/default/useradd 2>/dev/null || true
sed -i 's|SHELL=/bin/bash|SHELL=/bin/zsh|g' /etc/default/useradd 2>/dev/null || true

echo "✓ Shell defaults configured."
