#!/bin/sh
# ==============================================================================
# Chroot Hook: Configure Hardware Acceleration & Wayland Defaults
# ==============================================================================

set -e

echo "⚡ [NewbianOS Hook] Configuring hardware video acceleration & Ozone flags..."

cat << 'EOF' > /etc/environment
ELECTRON_OZONE_PLATFORM_HINT=auto
LIBVA_DRIVER_NAME=iHD
VDPAU_DRIVER=va_gl
QT_QPA_PLATFORM="wayland;xcb"
GDK_BACKEND="wayland,x11"
MOZ_ENABLE_WAYLAND=1
_JAVA_AWT_WM_NONREPARENTING=1
EOF

echo "✓ Hardware acceleration environment configured."
